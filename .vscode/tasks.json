{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "JuliaHub Authenticate",
      "type": "shell",
      "command": "julia",
      "args": [
        "--startup-file=no",
        "--history-file=no",
        "-e",
        "using JuliaHub; JuliaHub.authenticate(); using Pkg; Pkg.Registry.add()"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      }
    }
  ]
}